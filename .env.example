# Copy to .env (which is ignored by git); fill in credentials from your UC3M email.
# Replace XX with your two-digit number and YYYYYYYYY with the assigned password.
# The database suffix can be a, b, c, or d; use ONE assigned database.
SQLALCHEMY_DATABASE_URI=mysql+pymysql://27_webapp_XX:YYYYYYYYY@mysql.lab.it.uc3m.es/27_webapp_XXa

# Use a long random secret, e.g. generated by: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret

# Leave 0 when visiting http://127.0.0.1:5000 in the lab. Set to 1 only with HTTPS.
SESSION_COOKIE_SECURE=0

# Optional initial staff account: prefer CLI arguments when seeding.
# ADMIN_EMAIL=manager@example.com
# ADMIN_PASSWORD=set-a-unique-long-password
