# Set a long, unpredictable secret. Do not commit your actual .env file.
SECRET_KEY=replace-with-a-long-random-secret
# Recommended when the site is served over HTTPS:
SESSION_COOKIE_SECURE=1
# Optional SQLite default is instance/cinema.db
# DATABASE_URL=sqlite:///cinema.db
# Optional initial staff account: prefer CLI arguments when seeding.
# ADMIN_EMAIL=manager@example.com
# ADMIN_PASSWORD=set-a-unique-long-password
